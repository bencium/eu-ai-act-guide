---
import { list, text, type Locale } from "../i18n/locales";
import release from "../data/skill-release.json";

interface Props { locale: Locale }
const { locale } = Astro.props;
const archiveSize = release.archiveBytes > 0
  ? `${new Intl.NumberFormat("en").format(release.archiveBytes)} bytes`
  : "Pending package build";
---

<article class="page-shell">
  <p class="eyebrow">{text(locale, "skill.version")} · {text(locale, "skill.releaseDate")}</p>
  <h1>{text(locale, "skill.title")}</h1>
  <p class="lede">{text(locale, "skill.intro")}</p>

  <dl class="release-facts">
    <div><dt>{text(locale, "skill.sizeLabel")}</dt><dd>{archiveSize}</dd></div>
    <div><dt>{text(locale, "skill.hashLabel")}</dt><dd><code>{release.sha256}</code></dd></div>
  </dl>

  <div class="action-row">
    <a class="button" href={`/downloads/${release.archiveFile}`} download>{text(locale, "skill.download")}</a>
    <a class="button secondary" href={`/downloads/${release.rawFile}`}>{text(locale, "skill.raw")}</a>
    <a class="button secondary" href={`/downloads/${release.checksumFile}`} download>{text(locale, "skill.checksum")}</a>
  </div>
  <p><a href="https://github.com/bencium/eu-ai-act-guide/releases/tag/v1.0.0">{text(locale, "skill.github")}</a></p>

  <section class="content-block">
    <p class="info-panel">{text(locale, "skill.installWarning")}</p>
    <div class="install-grid">
      <section>
        <h2>{text(locale, "skill.codexTitle")}</h2>
        <pre>{list(locale, "skill.codexSteps").join("\n")}</pre>
      </section>
      <section>
        <h2>{text(locale, "skill.claudeTitle")}</h2>
        <pre>{list(locale, "skill.claudeSteps").join("\n")}</pre>
      </section>
    </div>
  </section>
</article>

<style>
  .release-facts { display: grid; gap: 0.75rem; margin-block: 2rem; }
  .release-facts div { display: grid; grid-template-columns: 10rem minmax(0, 1fr); gap: 1rem; padding-block: 0.75rem; border-bottom: 1px solid var(--line); }
  .release-facts dt { font-weight: 750; }
  .release-facts dd { margin: 0; overflow-wrap: anywhere; }
  .install-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  @media (max-width: 48rem) { .install-grid { grid-template-columns: 1fr; } }
  @media (max-width: 34rem) { .release-facts div { grid-template-columns: 1fr; gap: 0.25rem; } }
</style>
