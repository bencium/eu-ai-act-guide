---
import DecisionTool from "./DecisionTool.astro";
import { routeFor, type LanguageCode } from "../i18n/languages";
import { text, type Locale } from "../i18n/locales";

interface Props {
  lang: LanguageCode;
  locale: Locale;
  toolId: "what-it-means" | "does-it-apply" | "label-content";
  embedded?: boolean;
}

const { lang, locale, toolId, embedded = false } = Astro.props;
const prefix = {
  "what-it-means": "tool1",
  "does-it-apply": "tool2",
  "label-content": "tool3"
}[toolId];
---

<article class="page-shell">
  {!embedded && <p class="eyebrow">{text(locale, "common.independent")} {text(locale, "common.notLegalAdvice")}</p>}
  {embedded
    ? <h2 data-tool-heading tabindex="-1">{text(locale, `${prefix}.title`)}</h2>
    : <h1 data-tool-heading tabindex="-1">{text(locale, `${prefix}.title`)}</h1>}
  <p class="lede">{text(locale, `${prefix}.intro`)}</p>
  {!embedded && <p class="boundary-note">{text(locale, `${prefix}.limit`)}</p>}

  {toolId === "does-it-apply" && (
    <details class="tool-help">
      <summary>{text(locale, "tool2.smeLink")} / {text(locale, "tool2.midcapLink")}</summary>
      <p>{text(locale, "tool2.smeHelp")} <a href="https://eur-lex.europa.eu/eli/reco/2003/361/oj/eng" rel="external">{text(locale, "tool2.smeLink")}</a></p>
      <p>{text(locale, "tool2.midcapHelp")} <a href="https://eur-lex.europa.eu/eli/reco/2025/1099/oj/eng" rel="external">{text(locale, "tool2.midcapLink")}</a></p>
    </details>
  )}

  {toolId === "label-content" && (
    <details class="tool-help">
      <summary>{text(locale, "common.officialSourceLinks")}</summary>
      <div class="source-links">
        <a href="https://digital-strategy.ec.europa.eu/en/library/guidelines-transparency-obligations-providers-and-deployers-ai-systems" rel="external">{text(locale, "tool3.guidelines")}</a>
        <a href="https://digital-strategy.ec.europa.eu/en/policies/code-practice-ai-generated-content" rel="external">{text(locale, "tool3.code")}</a>
        <a href="https://digital-strategy.ec.europa.eu/en/policies/eu-icons-labelling-ai-generated-content" rel="external">{text(locale, "tool3.icons")}</a>
      </div>
      <p>{text(locale, "tool3.iconNote")}</p>
    </details>
  )}

  <DecisionTool locale={locale} toolId={toolId} />

  <p class="disclaimer-panel tool-disclaimer">
    {text(locale, "result.disclaimer")} <a href={routeFor(lang, "disclaimer")}>{text(locale, "common.disclaimer")}</a>
  </p>
</article>

<style>
  .tool-help { margin-top: 1.5rem; padding: 1rem; border: 1px solid var(--line); background: var(--white); }
  .tool-help summary { cursor: pointer; font-weight: 700; }
  .tool-help p { margin-block: 0.7rem 0.4rem; }
  .source-links { display: flex; flex-wrap: wrap; gap: 0.5rem 1rem; }
  details .source-links { margin-top: 0.8rem; }
  .tool-disclaimer { margin-top: 2rem; }
</style>
