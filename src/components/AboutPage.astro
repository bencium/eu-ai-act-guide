---
import { list, text, type Locale } from "../i18n/locales";

interface Props { locale: Locale }
const { locale } = Astro.props;
---

<article class="page-shell">
  <p class="eyebrow">{text(locale, "common.independent")} {text(locale, "common.notOfficial")}</p>
  <h1>{text(locale, "about.title")}</h1>
  {list(locale, "about.paragraphs").map((paragraph, index) => (
    <p class={index === 0 ? "lede" : undefined}>{paragraph}</p>
  ))}
  <section class="content-block">
    <h2>{text(locale, "about.publisherTitle")}</h2>
    <address>
      {list(locale, "about.publisherLines").map((line) => <>{line}<br /></>)}
    </address>
  </section>
</article>
