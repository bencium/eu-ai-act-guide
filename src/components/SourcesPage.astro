---
import { list, text, type Locale } from "../i18n/locales";
import sourceRegister from "../../sources/source-register.json";

interface Props { locale: Locale }
const { locale } = Astro.props;

const sourceLinks = sourceRegister.sources.map((source) => {
  let authorityKey = "sources.authorityLaw";
  if (source.category === "official_guidance") authorityKey = "sources.authorityGuidance";
  if (source.category === "voluntary_code") authorityKey = "sources.authorityVoluntary";
  if (source.category === "optional_official_asset") authorityKey = "tool3.icons";

  return {
    label: source.title,
    url: source.url,
    authorityKey
  };
});
---

<article class="page-shell">
  <p class="eyebrow">{text(locale, "common.sourceChecked")}</p>
  <h1>{text(locale, "sources.title")}</h1>
  <p class="lede">{text(locale, "sources.intro")}</p>

  <section class="content-block">
    <h2>{text(locale, "sources.originalTitle")}</h2>
    <p>{text(locale, "sources.originalBody")}</p>
  </section>

  <section class="content-block">
    <h2>{text(locale, "sources.currentTitle")}</h2>
    <p>{text(locale, "sources.currentBody")}</p>
  </section>

  <section class="content-block">
    <h2>{text(locale, "sources.timelineTitle")}</h2>
    <ul class="plain-list">
      {list(locale, "sources.timelineItems").map((item) => <li>{item}</li>)}
    </ul>
  </section>

  <section class="content-block">
    <h2>{text(locale, "sources.corrigendaTitle")}</h2>
    <ul class="plain-list">
      {list(locale, "sources.corrigendaItems").map((item) => <li>{item}</li>)}
    </ul>
  </section>

  <section class="content-block" aria-label={text(locale, "common.officialSourceLinks")}>
    {sourceLinks.map(({ label, url, authorityKey }) => (
      <div class="source-entry">
        <span class="authority-label">{text(locale, authorityKey)}</span>
        <a href={url} rel="external">{label}</a>
      </div>
    ))}
  </section>

  <section class="content-block">
    <h2>{text(locale, "sources.archiveTitle")}</h2>
    <p>{text(locale, "sources.archiveBody")}</p>
    <a href="/source-register.json">{text(locale, "sources.registerLink")}</a>
  </section>
</article>

<style>
  .source-entry { display: grid; grid-template-columns: 10rem 1fr; gap: 1rem; padding-block: 0.85rem; border-bottom: 1px solid var(--line); }
  .authority-label { font-size: 0.82rem; font-weight: 750; letter-spacing: 0.05em; text-transform: uppercase; }
  @media (max-width: 34rem) { .source-entry { grid-template-columns: 1fr; gap: 0.25rem; } }
</style>
